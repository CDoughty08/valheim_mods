<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Copy to Environment.props and adjust for your machine. Environment.props is gitignored. -->
  <PropertyGroup>
    <!-- Steam install: game assemblies for compile/publicize -->
    <VALHEIM_INSTALL>C:\Program Files (x86)\Steam\steamapps\common\Valheim</VALHEIM_INSTALL>

    <!-- Gale Default profile: runtime BepInEx + plugin deploy -->
    <GALE_PROFILE>$(APPDATA)\com.kesomannen.gale\valheim\profiles\Default</GALE_PROFILE>
    <MOD_DEPLOYPATH>$(GALE_PROFILE)\BepInEx\plugins\Varia-VariaFood</MOD_DEPLOYPATH>
  </PropertyGroup>
</Project>
