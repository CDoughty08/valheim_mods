{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build active mod",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/build-active-mod.ps1",
        "-WorkspaceFolder",
        "${workspaceFolder}",
        "-FilePath",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "build VariaFood",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/VariaFood/VariaFood.csproj", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "build VariaWeight",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/VariaWeight/VariaWeight.csproj", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "build VariaTracking",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/VariaTracking/VariaTracking.csproj", "-c", "Release"],
      "group": "build",
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      }
    },
    {
      "label": "build all mods",
      "dependsOn": [
        "build VariaFood",
        "build VariaWeight",
        "build VariaTracking"
      ],
      "dependsOrder": "sequence",
      "group": "build",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false
      }
    }
  ]
}
